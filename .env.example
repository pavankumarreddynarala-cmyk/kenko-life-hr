# Supabase PostgreSQL. Use the transaction pooler for the application and the
# direct connection for migrations. Replace every placeholder locally only.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# OTP_PROVIDER must be exactly: supabase, twilio, or development.
# Development is rejected when NODE_ENV=production. Employee Portal sign-in is by
# email OTP (mobile number is still collected as employee data, but is not used to log in).
OTP_PROVIDER="development"
DEV_OTP="123456"

# Required when OTP_PROVIDER=supabase. Uses Supabase Auth's built-in email OTP
# endpoint — no extra Supabase Auth feature needs enabling.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Required when OTP_PROVIDER=twilio. Use a Twilio Verify service with an email
# channel configured (Twilio Verify + SendGrid integration).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
