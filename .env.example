# Supabase PostgreSQL. Use the transaction pooler for the application and the
# direct connection for migrations. Replace every placeholder locally only.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
JWT_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Employee authentication uses Supabase Auth email magic links. Add
# APP_URL/employee to Supabase Auth > URL Configuration > Redirect URLs.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Only this account can create or reset logins (R1). Defaults to pavan@thekenkolife.com.
SUPER_ADMIN_EMAIL="pavan@thekenkolife.com"
# Used once by `npm run bootstrap:admin` to set that account's password. Do not keep it in .env afterwards.
# BOOTSTRAP_ADMIN_PASSWORD=""
